# Supabase project settings from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# GitHub Pages repository path, for example /wordle-1v1/
# VITE_BASE_PATH=/your-repository-name/
